<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>List</h1>

    <% if(arr.length>0) { %>
        <p>
       <ul>
            <% arr.forEach(function(item) { %>
            <li><%= item %></li>
            <% }) %>   
        </ul>
        </p>
    <% } else{  %>
        <p>No items</p>
    <% } %>

      
</body>
</html>